GEMINI_API_KEY=
# Optional. More Gemini keys, comma-separated. A key that hits its quota or billing cap is benched and the next one is used.
GEMINI_API_KEYS=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional. SEC EDGAR asks for a descriptive User-Agent with a contact email.
SEC_USER_AGENT=
# Optional. Upstash Redis (or Vercel KV) for a persistent cache and shared rate limits. Without it, results are cached
# in memory and in ~/.cache/aperture-shared (or APERTURE_CACHE_DIR), which also serves the last good value if a provider fails.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Supabase project for Google sign-in and saved portfolios (see supabase/README.md). Accounts stay off unless
# NEXT_PUBLIC_ACCOUNTS=1, which should be set only after supabase/migrations are applied to that project.
NEXT_PUBLIC_ACCOUNTS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Finnhub webhooks (/api/webhooks/finnhub): the secret Finnhub sends in X-Finnhub-Secret.
FINNHUB_WEBHOOK_SECRET=
# Optional, server only. Lets webhooks see which tickers are held in saved portfolios.
SUPABASE_SERVICE_ROLE_KEY=
APERTURE_CACHE_DIR=
APERTURE_LOCAL_VERIFICATION=
NEXT_PUBLIC_APERTURE_LOCAL_VERIFICATION=
APERTURE_ALPHA_DAILY_BUDGET=0
FRED_API_KEY=
OPENFIGI_API_KEY=
