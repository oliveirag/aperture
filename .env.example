GEMINI_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional. SEC EDGAR asks for a descriptive User-Agent with a contact email.
SEC_USER_AGENT=
# Optional. Upstash Redis (or Vercel KV) for a persistent cache and shared rate limits; memory only without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Supabase project for Google sign-in and saved portfolios (see supabase/README.md); accounts stay off without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Finnhub webhooks (/api/webhooks/finnhub): the secret Finnhub sends in X-Finnhub-Secret.
FINNHUB_WEBHOOK_SECRET=
# Optional, server only. Lets webhooks see which tickers are held in saved portfolios.
SUPABASE_SERVICE_ROLE_KEY=
